# Live Resend settings. A template only: no real values here.
#
# 1. Copy this file to .env  (cp .env.example .env  or  copy .env.example .env)
# 2. Fill in your own values in .env. .env is gitignored and must never be committed.
# 3. Start Claude Code in live mode:  node scripts/claude-live.mjs
#    Plain `claude` still uses the local practice emulator.

# From resend.com > API Keys. Starts with re_
RESEND_API_KEY=re_your_key_here

# The real Resend API. Leave as is.
RESEND_BASE_URL=https://api.resend.com

# Without your own verified domain, keep onboarding@resend.dev.
SENDER_EMAIL_ADDRESS=onboarding@resend.dev

# The email you signed up to Resend with. The send guard allows only this
# address and @resend.dev test addresses.
MY_EMAIL=you@example.com
